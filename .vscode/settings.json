{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",



    "java.test.defaultConfig": "test",
    "java.test.config": [
        {
            "name": "test",
            "modulePaths": ["${workspaceFolder}/cascara-schema-lib/build/modulepath"],
            "module": "cascara.schema",
            "vmArgs": [
                "--add-reads", "cascara.schema=cascara.test.common.junit"
            ],
            "classPaths": [
                "${workspaceFolder}/cascara-schema-lib/build/classes/java/main",
                "${workspaceFolder}/cascara-schema-lib/build/resources/main"
            ]
        },
        {
            "name": "integration-test",
            "modulePaths": ["${workspaceFolder}/integration-test/build/modulepath"],
            "module": "integration-test",
            "classPaths": [
                "${workspaceFolder}/integration-test/build/classes/java/main",
                "${workspaceFolder}/integration-test/build/resources/main"
            ]
        },
    ],

    "java.project.outputPath": "build/classes/java/main",
    "files.exclude": {
        "**/bin": true
    },
}