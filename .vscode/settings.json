{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",



    "java.test.defaultConfig": "tests",
    "java.test.config": [
        {
            "name": "tests",
            "modulePaths": ["${workspaceFolder}/cascara-schema/build/modulepath"],
            "module": "cascara.schema",
            "classPaths": [
                "${workspaceFolder}/cascara-schema/build/classes/java/main",
                "${workspaceFolder}/cascara-schema/build/resources/main"
            ]
        },
        {
            "name": "modular-tests",
            "modulePaths": ["${workspaceFolder}/schema-test/build/modulepath"],
            "module": "schema-test",
            "vmArgs": [
                "--module-path",
                "${workspaceFolder}/schema-test/build/modulepath",
            ],
            "java.project.referencedLibraries": [
                "${workspaceFolder}/schema-test/build/modulepath/*.jar"
            ]
        },
    ],

