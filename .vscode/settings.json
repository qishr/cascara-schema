{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",



    "java.test.defaultConfig": "test",
    "java.test.config": [
        {
            "name": "test",
            "modulePaths": ["${workspaceFolder}/cascara-schema/build/modulepath"],
            "module": "cascara.schema",
            "classPaths": [
                "${workspaceFolder}/cascara-schema/build/classes/java/main",
                "${workspaceFolder}/cascara-schema/build/resources/main"
            ]
        },
        {
            "name": "spl-test",
            "modulePaths": ["${workspaceFolder}/spl-test/build/modulepath"],
            "module": "schema-test",
            "classPaths": [
                "${workspaceFolder}/spl-test/build/classes/java/main",
                "${workspaceFolder}/spl-test/build/resources/main"
            ]
        },
    ],

    "java.project.outputPath": "build/classes/java/main",
    "files.exclude": {
        "**/bin": true
    },

    "workbench.colorTheme": "Cascara Retro Amber on Heavy Metal"

}